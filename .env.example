# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=vernacpay_global_super_secure_session_secret_2026

# Authoritative Database (PostgreSQL on Render or Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vernacpay_global

# Anthropic Claude Intelligence Layer
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Sarvam AI Indic Speech Suite (Telugu, Hindi, Urdu, English)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v1
SARVAM_TTS_MODEL=bulbul:v1

# PayPal Developer Platform (Sandbox Environment)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Deterministic FX Rate Engine (INR to USD Reference Rate)
FX_INR_TO_USD_RATE=84.00
