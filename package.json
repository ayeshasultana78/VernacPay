{
  "name": "vernacpay-global",
  "version": "2.0.0",
  "description": "The Multilingual, Voice-Native Agentic Commerce & Cross-Border Export Operating System Built on PayPal",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx src/server/db/seed.ts"
  },
  "keywords": [
    "paypal",
    "agentic-commerce",
    "ag-grid",
    "render",
    "sarvam-ai",
    "anthropic",
    "vernacular",
    "fintech",
    "cross-border"
  ],
  "author": "VernacPay-Global Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.106.1",
    "ag-grid-community": "^32.3.3",
    "ag-grid-react": "^32.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "motion": "^14.10.0",
    "msw": "^2.15.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.18.1",
    "sonner": "^2.0.8",
