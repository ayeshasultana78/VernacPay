{
  "mcpServers": {
    "render": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.render.com/mcp",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer ${RENDER_API_KEY}"
      }
    },
    "paypal": {
      "command": "npx",
      "args": ["-y", "@paypal/agent-toolkit/mcp", "--tools=all"],
      "env": {
        "PAYPAL_ENVIRONMENT": "SANDBOX"
      }
    },
    "ag-mcp": {
      "command": "npx",
      "args": ["-y", "ag-mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/vernacpay_global"]
    }
  }
}
